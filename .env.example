# ============================================================
# LangGraph 智能体框架环境变量配置
# 复制此文件为 .env 并填入真实值
# ============================================================

# --- LLM 提供商 ---
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_BASE_URL=https://api.openai.com/v1      # 可替换为代理地址
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

# 客服 Agent LLM（与 OPENAI_* 共用同一兼容接口时，只改模型名即可）
# GENERATOR_MODEL=qwen3.5-flash
# ANALYSIS_MODEL=qwen-flash

# Anthropic (可选)
# ANTHROPIC_API_KEY=your-anthropic-key

# --- Embedding（向量嵌入，仅入库时使用）---
# 采用本地 Ollama bge-m3，不参与实时对话，不影响并发
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIM=1024                     # bge-m3 输出维度固定为 1024

# --- Ollama 本地模型（仅 Embedding 用）---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3

# --- Milvus 向量数据库 ---
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=                                   # 无认证时留空
MILVUS_PASSWORD=
MILVUS_DB_NAME=default
MILVUS_DEFAULT_COLLECTION=agent_memory

# --- kb.py：products 入库默认 category（可选）---
# 未传 --category 时，若设置此项则视为已提供 category（与 Milvus products schema 对齐）
# KB_PRODUCTS_DEFAULT_CATEGORY=沐浴乳

# --- PostgreSQL 全文检索库 ---
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your-pg-password
PG_DATABASE=agent_db
PG_POOL_MIN=1
PG_POOL_MAX=10

# --- BM25 / 分词配置 ---
JIEBA_USER_DICT=                               # 自定义词典路径，留空则使用默认
BM25_K1=1.5
BM25_B=0.75

# --- RRF 混合检索参数 ---
RRF_K=60
HYBRID_VECTOR_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4

# --- 工具配置 ---
TAVILY_API_KEY=your-tavily-key-here

# --- LangSmith 可观测性 (可选) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_PROJECT=ai-customer-service

# --- Redis (可选，用于持久化记忆) ---
REDIS_URL=redis://localhost:6379

# --- Elasticsearch 外部会话历史 ---
# 索引：ipad_chat_message，sender 字段对应 session_id，is_ai 区分角色
ES_HOST=192.168.4.198
ES_PORT=9200
ES_SCHEME=http
ES_API_KEY=                            # 有鉴权时填入，无鉴权留空

# --- 后端业务接口（PMS 商品 / OMS 订单，内网无鉴权） ---
# 统一 Base URL，换宿主只改这一行即可
BACKEND_BASE_URL=https://sales.xinjixiu.com.cn/prod-api
PMS_PRODUCT_LIST_PATH=/pms/product/detailList
OMS_ORDER_BASE_PATH=/oms/omsOrder

# --- CRM 对接：静默转人工 webhook（退货/退款/投诉类由 CRM 接管发话） ---
CRM_HUMAN_TRANSFER_WEBHOOK_URL=        # 留空则仅打结构化日志，不回调 CRM

# --- 服务配置 ---
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENVIRONMENT=development

# --- Pipeline 数据清洗 / 分块配置 ---
PIPELINE_CHUNK_SIZE=512            # 单块最大字符数
PIPELINE_CHUNK_OVERLAP=64          # 相邻块重叠字符数
PIPELINE_MIN_CHUNK_LENGTH=30       # 低于此长度的块丢弃
PIPELINE_MAX_CHUNK_LENGTH=10000    # 超过此长度截断
PIPELINE_BATCH_SIZE=64             # 每批写入检索库的块数
PIPELINE_ENABLE_SIMPLIFIED=true    # 是否启用繁简转换
PIPELINE_ENABLE_DEDUP=true         # 是否启用 MD5 去重

# --- 路径配置 ---
STAGING_ROOT=./data/staging        # 暂存区根目录（支持绝对路径，容器部署时覆盖此项）
DATA_UPLOAD_DIR=./data/uploads     # 文件上传目录（支持绝对路径）

# --- 限流配置 ---
RATE_LIMIT_ENABLED=true            # 是否启用限流
RATE_LIMIT_IP_PER_MINUTE=30        # 每 IP 每分钟最大请求数
RATE_LIMIT_SESSION_PER_MINUTE=20   # 每 session 每分钟最大对话次数
RATE_LIMIT_GLOBAL_PER_MINUTE=200   # 全局每分钟最大请求数

# --- CORS 配置 ---
# 开发环境留空或设 ["*"]；生产环境填写实际域名
# ALLOWED_ORIGINS=["https://your-domain.com","https://www.your-domain.com"]

# --- API 鉴权 ---
API_SECRET_KEY=                    # 生产环境填入密钥；留空则不鉴权
API_KEY_HEADER=X-API-Key           # 鉴权 Header 名称
